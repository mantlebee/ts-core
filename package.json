{
  "name": "@mantlebee/ts-core",
  "version": "0.29.1",
  "description": "Common types, patterns and utilities for TypeScript projects.",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "docs/**/*",
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup --config && tsc-alias",
    "coverage": "jest --coverage --collectCoverageFrom='./src/**'",
    "doc": "typedoc",
    "doc:publish": "npm run doc && node ./gh-pages.js",
    "prepublishOnly": "npm run build && npm run doc",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantlebee/ts-core.git"
  },
  "keywords": [
    "typescript",
    "common",
    "utilities"
  ],
  "author": "MantleBee",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mantlebee/ts-core/issues"
  },
  "homepage": "https://github.com/mantlebee/ts-core#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "gh-pages": "6.3.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "rimraf": "6.1.3",
    "rollup": "4.63.1",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.3",
    "tslib": "2.8.1",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
